# Frontend uses Expo's public env var convention (EXPO_PUBLIC_ prefix) so these are
# safe to ship in the client bundle - no secret keys here, only public identifiers.
#EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
# Android physical device
#EXPO_PUBLIC_API_LAN_URL=http://10.216.164.167:4000

EXPO_PUBLIC_API_BASE_URL=http://10.216.164.167:4000
EXPO_PUBLIC_API_LAN_URL=http://10.216.164.167:4000

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# Check-in screen's local AI companion - talks directly to a locally-running
# Ollama instance (`ollama serve`, default port 11434), not Mansakha's backend.
# 127.0.0.1 only resolves to Ollama when the app and Ollama run on the same
# machine (e.g. `expo start --web`); point this at a LAN IP to reach Ollama
# running on another machine on the same network.
EXPO_PUBLIC_OLLAMA_BASE_URL=http://127.0.0.1:11434
EXPO_PUBLIC_OLLAMA_MODEL=gemma3:4b
