{
  "expo": {
    "name": "Mansakha",
    "slug": "mansakha",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "web"
    ],
    "android": {
      "package": "in.gov.mosje.mansakha",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Mansakha uses your location to auto-fill your State and District at login."
        }
      ],
      "expo-audio"
    ]
  }
}
