# Supabase (free tier) - https://supabase.com
# NOTE: this file is committed to git - real values belong only in the
# gitignored .env, never here. (Fixed 2026-09-11: this file previously had
# the actual project's real publishable/secret keys checked in - rotate
# those keys if this repo has ever been public/shared.)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# App auth - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Ministry Super Admin - fixed, deliberately-chosen bootstrap credentials (not
# randomly generated), used by `npm run seed:super-admin` (src/db/seedSuperAdmin.js).
# Change these before running the seed script for real deployment.
SUPER_ADMIN_NAME=Ministry Super Admin
SUPER_ADMIN_EMAIL=superadmin@mansakha.gov.in
SUPER_ADMIN_PASSWORD=Mansakha@2026

# Shared secret for the internal-only AI route (POST /api/ai/analyze-interaction) -
# never given to a client, only used server-to-server. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# AI - Gemini free tier (Google AI Studio), do NOT attach a billing account
GEMINI_API_KEY=

# Twilio - Messages API (console.twilio.com), used by services/dispatchWorker.js
# for SMS check-in prompts (Feature Catalog Section 1.3).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Exotel (IVRS) - NOT a free tier. Real phone calls cost money to terminate on the
# telecom network. Run this on Exotel's trial credit for hackathon-scale demo volume
# only; do not add a payment method. If trial credit runs out, stop testing IVRS
# rather than upgrading the account.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=


# Direct Postgres (bypasses PostgREST, needed for DDL migrations - supabase-js's
# REST client can't run ALTER TABLE etc.). Stored as separate fields, not a single
# DATABASE_URL, in case the password contains "@" (breaks connection-string
# parsing unless percent-encoded). Get these from Project Settings -> Database.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
FRONTEND_URL=http://localhost:8081
