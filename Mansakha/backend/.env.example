# Supabase (free tier) - https://supabase.com
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App auth
JWT_SECRET=

# Ministry Super Admin - fixed, deliberately-chosen bootstrap credentials (not
# randomly generated), used by `npm run seed:super-admin` (src/db/seedSuperAdmin.js).
# Change these before running the seed script for real deployment.
SUPER_ADMIN_NAME=Ministry Super Admin
SUPER_ADMIN_EMAIL=superadmin@mansakha.gov.in
SUPER_ADMIN_PASSWORD=

# Shared secret for the internal-only AI route (POST /api/ai/analyze-interaction) -
# never given to a client, only used server-to-server. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=

# AI - Gemini free tier (Google AI Studio), do NOT attach a billing account
GEMINI_API_KEY=

# Email OTP - sent via SMTP (services/mailer.js), we own generation/expiry
# ourselves (email_otp_codes table). Gmail SMTP: create an App Password at
# myaccount.google.com/apppasswords (needs 2-Step Verification enabled first).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Mobile OTP - Twilio Verify (console.twilio.com), owns generation/expiry/attempt
# limiting on its side. Create a Verify Service under Verify -> Services to get
# the Service SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Exotel (IVRS) - NOT a free tier. Real phone calls cost money to terminate on the
# telecom network. Run this on Exotel's trial credit for hackathon-scale demo volume
# only; do not add a payment method. If trial credit runs out, stop testing IVRS
# rather than upgrading the account.
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=

# Google OAuth (Victim Gmail login) - free
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
FRONTEND_URL=http://localhost:8081
